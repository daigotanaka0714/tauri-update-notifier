#!/usr/bin/env bash
#
# bin/agent-check - the single command that decides whether this repo is "done".
#
# Usage:
#   ./bin/agent-check          # run every check
#   ./bin/agent-check --fix    # auto-fix what can be fixed, then check
#
# Exit code: 0 = green / 1 = at least one check failed
#
# Plain bash plus pnpm. No editor, agent or AI tooling is required to run it.
# .github/workflows/ci.yml runs the same commands in the same order, so a local
# PASS is a good predictor of a green CI run. If one has to change, change both:
# a gate that disagrees with CI is worse than no gate at all.

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# IMPORTANT: set NODE_ENV per stage. Never pin it for the whole script.
#
#   A parent process (a desktop agent host, for example) may carry
#   NODE_ENV=production, and any shell started from it inherits that.
#   Run vitest in that state and React resolves to its production build,
#   act() is unavailable, and every test fails.
#   But pinning the whole script to NODE_ENV=test is wrong too: this repo
#   builds a package that gets published to npm, and that build must run
#   in production mode.
#
#   So each stage is handed the NODE_ENV it actually needs.
#   No stage may rely on the inherited value.
NODE_ENV_TEST=test
NODE_ENV_BUILD=production

FIX=0
for arg in "$@"; do
  case "$arg" in
    --fix)   FIX=1 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

PNPM="pnpm"
command -v pnpm >/dev/null 2>&1 || { echo "pnpm not found" >&2; exit 2; }

FAILED_STAGE=""
TIMINGS=""

run_stage() {
  # run_stage <stage> <description> <command...>
  local name="$1"; shift
  local desc="$1"; shift
  local start end out rc
  printf '>>> %-10s %s\n' "$name" "$desc"
  start=$(date +%s)
  out=$("$@" 2>&1)
  rc=$?
  end=$(date +%s)
  TIMINGS="${TIMINGS}${name}:$((end - start))s "
  if [ $rc -ne 0 ]; then
    echo "$out" | tail -40
    [ -z "$FAILED_STAGE" ] && FAILED_STAGE="$name"
    return 1
  fi
  return 0
}

if [ "$FIX" = "1" ]; then
  echo ">>> fix        biome check --write"
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec biome check --write . >/dev/null 2>&1
fi

OK=1

# There is deliberately no mechanism for tolerating warnings (no "allow up to N"
# ratchet). Such a budget only ever moves in one direction, so --error-on-warnings
# fixes the ceiling at zero instead.
run_stage lint "biome check --error-on-warnings" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec biome check --error-on-warnings . || OK=0

run_stage typecheck "tsc --noEmit" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec tsc --noEmit || OK=0

# e2e (Playwright screenshot capture) is not part of the gate: it needs a browser
# install and only produces the README images - it verifies nothing about the
# library itself. Run it by hand with `pnpm e2e`.
#
# Coverage is measured here too. vitest.config.ts carries the thresholds, so a
# drop fails this stage. Coverage that nobody acts on is not worth measuring.
run_stage test "vitest run --coverage (thresholds enforced)" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec vitest run --coverage || OK=0

run_stage build "tsup (builds the published package)" \
  env NODE_ENV="$NODE_ENV_BUILD" $PNPM exec tsup || OK=0

echo
echo "=== AGENT-CHECK RESULT ==="
if [ "$OK" = "1" ]; then
  echo "STATUS: PASS"
  echo "TIMINGS: ${TIMINGS}"
  echo "NEXT: Safe to open a PR. Do not merge - a human reviews and merges."
  exit 0
else
  echo "STATUS: FAIL"
  echo "FAILED_STAGE: $FAILED_STAGE"
  echo "TIMINGS: ${TIMINGS}"
  echo "NEXT: Fix the $FAILED_STAGE errors above and re-run bin/agent-check."
  echo "NEXT: Do not open a PR until this is green."
  exit 1
fi
