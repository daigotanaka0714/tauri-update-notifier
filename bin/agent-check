#!/usr/bin/env bash
#
# bin/agent-check — AIエージェントの「完了条件」チェッカー
#
# 使い方:
#   ./bin/agent-check          # 全部の検査を走らせる
#   ./bin/agent-check --fix    # 自動修正できるものを直してから検査する
#
# 終了コード: 0=green / 1=いずれかの検査が失敗

set -uo pipefail
cd "$(dirname "$0")/.." || exit 1

# 【重要】NODE_ENV はステージ単位で指定する。スクリプト全体で固定してはいけない。
#
#   Claude デスクトップのようなホストプロセスは NODE_ENV=production を持っており、
#   そこから起動したエージェントのシェルはそれを継承する。
#   その状態で vitest を走らせると React が production ビルドに解決され、
#   act() が使えずテストが全滅する。
#   一方でスクリプト全体を NODE_ENV=test で固定すると、今度はライブラリの
#   ビルド成果物が本番と変わってしまう（このリポジトリは npm 公開物を作る）。
#
#   だからステージごとに「そのステージが必要とする NODE_ENV」を渡す。
#   継承した値をそのまま使うステージを作らないこと。
NODE_ENV_TEST=test
NODE_ENV_BUILD=production

FIX=0
for arg in "$@"; do
  case "$arg" in
    --fix)   FIX=1 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

PNPM="pnpm"
command -v pnpm >/dev/null 2>&1 || { echo "pnpm が見つかりません" >&2; exit 2; }

FAILED_STAGE=""
TIMINGS=""

run_stage() {
  # run_stage <stage名> <説明> <コマンド...>
  local name="$1"; shift
  local desc="$1"; shift
  local start end out rc
  printf '── %-10s %s\n' "$name" "$desc"
  start=$(date +%s)
  out=$("$@" 2>&1)
  rc=$?
  end=$(date +%s)
  TIMINGS="${TIMINGS}${name}:$((end - start))s "
  if [ $rc -ne 0 ]; then
    echo "$out" | tail -40
    [ -z "$FAILED_STAGE" ] && FAILED_STAGE="$name"
    return 1
  fi
  return 0
}

if [ "$FIX" = "1" ]; then
  echo "── fix        biome check --write"
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec biome check --write . >/dev/null 2>&1
fi

OK=1

# 警告を握りつぶす仕組み（許容件数のラチェット等）はあえて入れていない。
# 「あと N 件までは許す」は必ず N が増える方向にしか動かないため、
# --error-on-warnings で「警告ゼロ」を天井に固定する。
run_stage lint "biome check --error-on-warnings" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec biome check --error-on-warnings . || OK=0

run_stage typecheck "tsc --noEmit" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec tsc --noEmit || OK=0

# e2e（Playwright のスクリーンショット撮影）はゲートに含めない。
# ブラウザのインストールが要るうえ、撮るのは README 用の画像であって
# ライブラリの正しさを検証していないため。手で撮るときは pnpm e2e。
run_stage test "vitest run" \
  env NODE_ENV="$NODE_ENV_TEST" $PNPM exec vitest run || OK=0

run_stage build "tsup（npm 公開物のビルド）" \
  env NODE_ENV="$NODE_ENV_BUILD" $PNPM exec tsup || OK=0

echo
echo "=== AGENT-CHECK RESULT ==="
if [ "$OK" = "1" ]; then
  echo "STATUS: PASS"
  echo "TIMINGS: ${TIMINGS}"
  echo "NEXT: PR を作成してよい。マージは人間が行うため、マージはしないこと。"
  exit 0
else
  echo "STATUS: FAIL"
  echo "FAILED_STAGE: $FAILED_STAGE"
  echo "TIMINGS: ${TIMINGS}"
  echo "NEXT: 上の $FAILED_STAGE エラーを修正し、bin/agent-check を再実行すること。"
  echo "NEXT: green になるまで PR を作成しないこと。"
  exit 1
fi
